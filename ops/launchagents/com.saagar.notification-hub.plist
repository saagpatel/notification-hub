<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE — substitute before installing.

  Replace every __HOME__ token with your actual home directory (e.g. /Users/yourname).
  The default Label matches the project-owned LaunchAgent path.

  Install:
    sed 's|__HOME__|'"$HOME"'|g' ops/launchagents/com.saagar.notification-hub.plist \
      > ~/Library/LaunchAgents/com.saagar.notification-hub.plist
    launchctl bootstrap "gui/$(id -u)" ~/Library/LaunchAgents/com.saagar.notification-hub.plist
-->
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.saagar.notification-hub</string>
    <key>ProgramArguments</key>
    <array>
      <string>__HOME__/.local/state/notification-hub/current/bin/notification-hub-daemon</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__HOME__/.local/state/notification-hub/current/app</string>
    <key>Umask</key>
    <integer>63</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/notification-hub/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/notification-hub/stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
      <key>HOME</key>
      <string>__HOME__</string>
      <key>PATH</key>
      <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
      <key>PYTHONDONTWRITEBYTECODE</key>
      <string>1</string>
      <key>NOTIFICATION_HUB_BRIDGE_CURSOR_ENABLED</key>
      <string>1</string>
      <key>NOTIFICATION_HUB_PRESERVE_HISTORY</key>
      <string>1</string>
    </dict>
  </dict>
</plist>
